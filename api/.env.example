# Database — choose one:
#
# Local SQLite (default, no setup needed):
DATABASE_URL=sqlite:data.db?mode=rwc
#
# Turso (distributed SQLite — zero config on your side):
#   1. Install Turso CLI: brew install tursodatabase/tap/turso
#   2. turso auth signup && turso db create openslate
#   3. turso db show openslate --url       → copy the libsql:// URL
#   4. turso db tokens create openslate    → copy the auth token
#   5. Set both below, then build with: cargo run --features backend-turso
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token-here

HOST=0.0.0.0
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-random-string

# First-run: creates the admin user if none exists (only used once)
ADMIN_PASSWORD=your-password

# Cloudflare R2 (optional — media uploads disabled if not set)
# R2_BUCKET=your-bucket
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY=your-access-key
# R2_SECRET_KEY=your-secret-key
