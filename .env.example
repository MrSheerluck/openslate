# Required — a random secret for JWT tokens
JWT_SECRET=change-me-to-a-random-string

# Optional — set to your domain for automatic HTTPS (Let's Encrypt)
DOMAIN=

# Optional — Turso database (distributed SQLite)
# See api/.env.example for setup instructions
# DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token-here

# Optional — Cloudflare R2 credentials for media uploads
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
